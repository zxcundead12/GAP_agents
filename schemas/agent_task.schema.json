{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent_task",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation": {
      "type": "string",
      "enum": [
        "inspect",
        "validate",
        "report",
        "compare",
        "build",
        "smoke",
        "export",
        "unsupported"
      ]
    },
    "case_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "manifest_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "mapping_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "export_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "tolerances_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "clarifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "operation",
    "case_id",
    "manifest_path",
    "mapping_path",
    "export_path",
    "model_path",
    "tolerances_path",
    "clarifications"
  ]
}
