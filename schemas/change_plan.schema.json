{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "change_plan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "inspect",
            "validate",
            "report",
            "compare",
            "build",
            "smoke",
            "export",
            "unsupported"
          ]
        },
        "case_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "manifest_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "mapping_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "export_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "tolerances_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "clarifications": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "operation",
        "case_id",
        "manifest_path",
        "mapping_path",
        "export_path",
        "model_path",
        "tolerances_path",
        "clarifications"
      ]
    },
    "inputs": {
      "type": "object"
    },
    "integration_plan_id": {
      "type": "string"
    },
    "integration_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_model_path": {
      "type": "string"
    },
    "actions": {
      "type": "object"
    },
    "llm": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "task",
    "inputs",
    "integration_plan_id",
    "integration_plan_sha256",
    "target_model_path",
    "actions",
    "llm"
  ]
}
