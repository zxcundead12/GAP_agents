{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "manifest",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "sources",
    "selection",
    "nodes",
    "pipes",
    "valves",
    "ambiguities"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "sha256",
          "pages"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "pages": {
            "type": "array"
          }
        }
      }
    },
    "selection": {
      "type": "object"
    },
    "ambiguities": {
      "type": "array"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "original_label": {
            "type": "string",
            "minLength": 1
          },
          "review_status": {
            "enum": [
              "pending",
              "confirmed",
              "rejected"
            ]
          },
          "reviewed_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source_id",
                "raw_text",
                "method",
                "fields"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "raw_text": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "enum": [
                    "visual",
                    "text_layer",
                    "derived",
                    "text_file"
                  ]
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              }
            },
            "minItems": 1
          },
          "kind": {
            "enum": [
              "junction",
              "source",
              "boundary"
            ]
          },
          "context": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "id",
          "original_label",
          "review_status",
          "reviewed_by",
          "reviewed_at",
          "source_refs",
          "kind",
          "context",
          "position"
        ]
      }
    },
    "pipes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "original_label": {
            "type": "string",
            "minLength": 1
          },
          "review_status": {
            "enum": [
              "pending",
              "confirmed",
              "rejected"
            ]
          },
          "reviewed_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source_id",
                "raw_text",
                "method",
                "fields"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "raw_text": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "enum": [
                    "visual",
                    "text_layer",
                    "derived",
                    "text_file"
                  ]
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              }
            },
            "minItems": 1
          },
          "from_node": {
            "type": "string",
            "minLength": 1
          },
          "to_node": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "length_m": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0,
                "x-unit": "m"
              },
              "outer_diameter_mm": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0,
                "x-unit": "mm"
              },
              "wall_thickness_mm": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0,
                "x-unit": "mm"
              },
              "inner_diameter_mm": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0,
                "x-unit": "mm"
              }
            },
            "required": [
              "length_m",
              "outer_diameter_mm",
              "wall_thickness_mm",
              "inner_diameter_mm"
            ]
          },
          "role": {
            "enum": [
              "pipeline",
              "internal_connector"
            ]
          },
          "active_state": {
            "enum": [
              "active",
              "inactive",
              "unknown"
            ]
          }
        },
        "required": [
          "id",
          "original_label",
          "review_status",
          "reviewed_by",
          "reviewed_at",
          "source_refs",
          "from_node",
          "to_node",
          "parameters",
          "role",
          "active_state"
        ]
      }
    },
    "valves": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "original_label": {
            "type": "string",
            "minLength": 1
          },
          "review_status": {
            "enum": [
              "pending",
              "confirmed",
              "rejected"
            ]
          },
          "reviewed_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source_id",
                "raw_text",
                "method",
                "fields"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "raw_text": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "enum": [
                    "visual",
                    "text_layer",
                    "derived",
                    "text_file"
                  ]
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              }
            },
            "minItems": 1
          },
          "pipe_id": {
            "type": "string",
            "minLength": 1
          },
          "physical_state": {
            "enum": [
              "open",
              "closed",
              "unknown"
            ]
          },
          "size_dn_mm": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "pressure_rating_raw": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "original_label",
          "review_status",
          "reviewed_by",
          "reviewed_at",
          "source_refs",
          "pipe_id",
          "physical_state",
          "size_dn_mm",
          "pressure_rating_raw"
        ]
      }
    }
  }
}
